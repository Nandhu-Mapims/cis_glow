# Copy to .env and point at your Dockerized backend (docker-compose.yml → PORT=2003).
# Expo inlines any EXPO_PUBLIC_* var into the JS bundle at build/start time.
#
# Simulator/emulator on the same machine as the backend:
EXPO_PUBLIC_API_URL=http://localhost:2003/api
#
# Physical device on the same LAN as the backend (use your machine's LAN IP, not localhost):
# EXPO_PUBLIC_API_URL=http://192.168.1.50:2003/api
#
# Production, behind a reverse proxy with HTTPS:
# EXPO_PUBLIC_API_URL=https://cis.mapims.org/api
