{
  "name": "cis-server",
  "version": "1.0.0",
  "description": "CIS modernized backend - Express + Prisma",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "smoke:exam-elearning": "node scripts/smoke-exam-elearning-module.js",
    "test:all": "node scripts/run-all-module-tests.js --all",
    "test:crud": "node ../test/run.js",
    "test:latency": "node scripts/run-all-module-tests.js --all --json",
    "check:sql": "node scripts/check-raw-sql-interpolation.js",
    "db:pull": "prisma db pull",
    "db:normalize-dates": "node scripts/normalize-zero-dates.js --phase1 --dry-run",
    "db:normalize-dates:apply": "node scripts/normalize-zero-dates.js --phase1 --apply",
    "db:generate": "prisma generate",
    "studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.7.1",
    "@prisma/client": "6.19.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.22.5",
    "puppeteer": "^24.43.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "prisma": "6.19.3"
  }
}
